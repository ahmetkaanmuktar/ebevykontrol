<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kullanım istatistiklerine erişim izni (Uygulama ekran sürelerini ölçmek için) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Diğer uygulamaların üzerinde gösterim izni (Süre dolduğunda engelleme ekranını göstermek için) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Önyükleme tamamlandığında izleme servisini ve alarmları kontrol etme izni -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 13+ (API 33+) Yerel Bildirim İzni -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ebeveyn için Biyometrik (Parmak İzi / Yüz Tanıma) İzni -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Google Play Uyumlu: QUERY_ALL_PACKAGES yerine yalnızca başlatılabilir (Launcher) uygulamaları sorgulama -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ParentalControlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UygulamaKapatma"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.UygulamaKapatma">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Süre dolduğunda beliren kilit ekranı -->
        <activity
            android:name=".ui.block.BlockOverlayActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.UygulamaKapatma" />

        <!-- Erişilebilirlik Servisi (Ön plandaki uygulamanın süresini denetlemek için) -->
        <service
            android:name=".service.AppBlockerAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Cihaz açılışını, güncelleme ve saat değişimini yakalayan alıcı -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
